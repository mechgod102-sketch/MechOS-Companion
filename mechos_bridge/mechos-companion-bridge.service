[Unit]
Description=MechOS Companion Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/mechos-companion-bridge/relay.env
ExecStart=/usr/bin/python3 /usr/lib/mechos-companion-bridge/server_v020.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
